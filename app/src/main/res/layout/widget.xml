<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/widget_bg"
    android:clickable="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">
        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hava"
            android:textColor="@color/gold"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />
        <TextView
            android:id="@+id/requestTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:text="—" />
        <TextView
            android:id="@+id/settingsButton"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:text="⚙"
            android:textColor="@color/gold_dim"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/label1" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/gold_dim" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="دلار"/>
        <TextView android:id="@+id/price1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="—"/>
        <TextView android:id="@+id/pct1" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:text="—"/>
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/label2" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/gold_dim" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="یورو"/>
        <TextView android:id="@+id/price2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="—"/>
        <TextView android:id="@+id/pct2" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:text="—"/>
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/label3" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="طلا ۱۸"/>
        <TextView android:id="@+id/price3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="—"/>
        <TextView android:id="@+id/pct3" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:text="—"/>
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/label4" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/gold" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="سکه"/>
        <TextView android:id="@+id/price4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="—"/>
        <TextView android:id="@+id/pct4" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:text="—"/>
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="2dp" android:paddingBottom="2dp">
        <TextView android:id="@+id/label5" android:layout_width="56dp" android:layout_height="wrap_content" android:textColor="@color/gold_dim" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="انس"/>
        <TextView android:id="@+id/price5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:textColor="@color/text_main" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:text="—"/>
        <TextView android:id="@+id/pct5" android:layout_width="52dp" android:layout_height="wrap_content" android:gravity="end" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:text="—"/>
    </LinearLayout>

</LinearLayout>
